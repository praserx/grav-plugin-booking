{
  "name": "praserx/grav-plugin-booking",
  "type": "grav-plugin",
  "description": "Facility and room booking plugin for Grav 2.",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "getgrav/grav": ">=2.0",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Grav\\Plugin\\Booking\\": "classes/Booking/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Grav\\Plugin\\Booking\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
