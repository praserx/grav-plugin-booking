{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'PLUGIN_BOOKING.ADMIN.TITLE'|t }}{% endblock %}

{% block content %}
<div class="booking-admin">
    <div class="booking-header">
        <h1><i class="fa fa-calendar-check"></i> {{ 'PLUGIN_BOOKING.ADMIN.BOOKING_LIST'|t }}</h1>
    </div>

    {% if facilities is empty %}
        <div class="alert alert-warning">
            <i class="fa fa-exclamation-triangle"></i>
            {{ 'PLUGIN_BOOKING.PUBLIC.NO_FACILITIES'|t }}
        </div>
    {% else %}
        <div class="booking-filters">
            <div class="filter-group">
                <label for="facility-filter">{{ 'PLUGIN_BOOKING.ADMIN.FACILITY'|t }}:</label>
                <select id="facility-filter" class="form-select">
                    <option value="">{{ 'PLUGIN_ADMIN.ALL'|t }}</option>
                    {% for facility in facilities %}
                        <option value="{{ facility.slug }}">{{ facility.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-group">
                <label for="status-filter">{{ 'PLUGIN_BOOKING.ADMIN.STATUS'|t }}:</label>
                <select id="status-filter" class="form-select">
                    <option value="">{{ 'PLUGIN_ADMIN.ALL'|t }}</option>
                    <option value="pending">{{ 'PLUGIN_BOOKING.ADMIN.STATUS_PENDING'|t }}</option>
                    <option value="confirmed">{{ 'PLUGIN_BOOKING.ADMIN.STATUS_CONFIRMED'|t }}</option>
                    <option value="rejected">{{ 'PLUGIN_BOOKING.ADMIN.STATUS_REJECTED'|t }}</option>
                    <option value="cancelled">{{ 'PLUGIN_BOOKING.ADMIN.STATUS_CANCELLED'|t }}</option>
                </select>
            </div>
        </div>

        <div class="booking-list" data-booking-list>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>{{ 'PLUGIN_BOOKING.ADMIN.FACILITY'|t }}</th>
                        <th>{{ 'PLUGIN_BOOKING.ADMIN.RESOURCE'|t }}</th>
                        <th>{{ 'PLUGIN_BOOKING.ADMIN.CUSTOMER_NAME'|t }}</th>
                        <th>{{ 'PLUGIN_BOOKING.ADMIN.START_TIME'|t }}</th>
                        <th>{{ 'PLUGIN_BOOKING.ADMIN.END_TIME'|t }}</th>
                        <th>{{ 'PLUGIN_BOOKING.ADMIN.STATUS'|t }}</th>
                        <th>{{ 'PLUGIN_ADMIN.ACTIONS'|t }}</th>
                    </tr>
                </thead>
                <tbody data-booking-tbody>
                    <tr>
                        <td colspan="7" class="text-center">
                            <i class="fa fa-spinner fa-spin"></i> Loading...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="booking-pagination" data-booking-pagination></div>
    {% endif %}
</div>
{% endblock %}
