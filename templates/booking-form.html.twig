{% extends 'partials/base.html.twig' %}

{% set facilities = booking_facilities|default([]) %}
{% set requester = booking_requester|default({}) %}
{% set single_facility = facilities|length == 1 ? facilities|first : null %}
{% set booking_heading = single_facility ? single_facility.name : page.title|default(site.title) %}

{% block title %}{{ booking_heading|e }}{% endblock %}

{% block content %}
<div class="booking-public">
  <header class="booking-header">
    {% if booking_heading %}<h1>{{ booking_heading|e }}</h1>{% endif %}
    {% if page.content %}<div class="booking-page-content">{{ page.content|raw }}</div>{% endif %}
  </header>

  {% if facilities is empty %}
    <div class="alert alert-info"><p>{{ 'PLUGIN_BOOKING.PUBLIC.NO_FACILITIES'|t }}</p></div>
  {% else %}
    <form id="booking-form" class="booking-form" method="post"
          action="{{ booking_api_base }}/reservations"
          data-api-base="{{ booking_api_base|e('html_attr') }}"
          data-facilities="{{ facilities|json_encode|e('html_attr') }}">
      {{ nonce_field('booking-form', 'booking-nonce')|raw }}
      <div class="booking-trap" aria-hidden="true">
        <label for="booking-website">Leave this field empty</label>
        <input type="text" id="booking-website" name="website" tabindex="-1" autocomplete="off">
      </div>

      <nav class="booking-progress" aria-label="{{ 'PLUGIN_BOOKING.PUBLIC.BOOKING_PROGRESS'|t }}">
        <ol>
          <li class="is-current" aria-current="step" data-booking-progress-step="1">
            <span class="booking-progress-number">1</span><span>{{ 'PLUGIN_BOOKING.PUBLIC.STEP_DATES'|t }}</span>
          </li>
          <li data-booking-progress-step="2">
            <span class="booking-progress-number">2</span><span>{{ 'PLUGIN_BOOKING.PUBLIC.STEP_DETAILS'|t }}</span>
          </li>
          <li data-booking-progress-step="3">
            <span class="booking-progress-number">3</span><span>{{ 'PLUGIN_BOOKING.PUBLIC.STEP_VERIFY'|t }}</span>
          </li>
        </ol>
      </nav>

      <section class="booking-step" data-booking-selection>
      {% if single_facility %}
        <input type="hidden" id="facility_id" name="facility_id" value="{{ single_facility.id|e('html_attr') }}" data-booking-facility>
      {% else %}
        <div class="form-group">
          <label for="facility_id">{{ 'PLUGIN_BOOKING.PUBLIC.SELECT_FACILITY'|t }} *</label>
          <select id="facility_id" name="facility_id" required class="form-control" data-booking-facility>
            <option value="">{{ 'PLUGIN_BOOKING.PUBLIC.SELECT_FACILITY'|t }}...</option>
            {% for facility in facilities %}
              <option value="{{ facility.id|e('html_attr') }}">{{ facility.name|e }}</option>
            {% endfor %}
          </select>
        </div>
      {% endif %}

        <div class="booking-choice-row">
          <div class="form-group" data-resource-group hidden>
            <label for="resource_id">{{ 'PLUGIN_BOOKING.PUBLIC.SELECT_RESOURCE'|t }}</label>
            <select id="resource_id" name="resource_id" class="form-control" data-booking-resource>
              <option value="">{{ 'PLUGIN_BOOKING.PUBLIC.SELECT_RESOURCE'|t }}...</option>
            </select>
          </div>
          <div class="form-group" data-period-group hidden>
            <label for="period_id">{{ 'PLUGIN_BOOKING.PUBLIC.SELECT_PERIOD'|t }}</label>
            <select id="period_id" class="form-control" data-booking-period>
              <option value="">{{ 'PLUGIN_BOOKING.PUBLIC.SELECT_PERIOD_PROMPT'|t }}...</option>
            </select>
          </div>
        </div>

        <section class="booking-calendar" aria-labelledby="booking-calendar-title" data-calendar-section hidden>
          <div class="booking-calendar-heading">
            <div>
              <h2 id="booking-calendar-title">{{ 'PLUGIN_BOOKING.PUBLIC.CHOOSE_DATES'|t }}</h2>
              <p class="booking-muted">{% if single_facility %}{{ 'PLUGIN_BOOKING.PUBLIC.CALENDAR_HINT_SINGLE'|t }}{% else %}{{ 'PLUGIN_BOOKING.PUBLIC.CALENDAR_HINT'|t }}{% endif %}</p>
            </div>
            <div class="booking-calendar-legend" aria-label="{{ 'PLUGIN_BOOKING.PUBLIC.AVAILABILITY'|t }}">
              <span><i class="booking-dot booking-dot-available"></i>{{ 'PLUGIN_BOOKING.PUBLIC.AVAILABLE'|t }}</span>
              <span><i class="booking-dot booking-dot-unavailable"></i>{{ 'PLUGIN_BOOKING.PUBLIC.UNAVAILABLE'|t }}</span>
            </div>
          </div>
          <div class="booking-calendar-layout">
            <div class="booking-calendar-main">
              <div class="booking-calendar-controls">
                <button type="button" class="btn btn-secondary booking-month-button" data-calendar-previous aria-label="{{ 'PLUGIN_BOOKING.PUBLIC.PREVIOUS_MONTH'|t }}">‹</button>
                <h3 data-calendar-month aria-live="polite"></h3>
                <button type="button" class="btn btn-secondary booking-month-button" data-calendar-next aria-label="{{ 'PLUGIN_BOOKING.PUBLIC.NEXT_MONTH'|t }}">›</button>
              </div>
              <div class="booking-calendar-grid" role="grid" aria-label="{{ 'PLUGIN_BOOKING.PUBLIC.CHOOSE_DATES'|t }}">
                <div class="booking-weekdays" data-calendar-weekdays role="row"></div>
                <div class="booking-days" data-calendar-days role="rowgroup"></div>
              </div>
            </div>

            <aside class="booking-selection-panel" aria-labelledby="booking-selection-title" data-selection-panel>
              <h3 id="booking-selection-title">{{ 'PLUGIN_BOOKING.PUBLIC.YOUR_SELECTION'|t }}</h3>
              <dl class="booking-selection-summary" data-selection-summary hidden>
                <div>
                  <dt>{{ 'PLUGIN_BOOKING.PUBLIC.CHECK_IN'|t }}</dt>
                  <dd data-selected-start></dd>
                </div>
                <div data-selected-end-wrap hidden>
                  <dt>{{ 'PLUGIN_BOOKING.PUBLIC.CHECK_OUT'|t }}</dt>
                  <dd data-selected-end></dd>
                </div>
              </dl>
              <p class="booking-muted booking-checkout-note" data-checkout-note hidden>{{ 'PLUGIN_BOOKING.PUBLIC.CHECK_OUT_BOUNDARY_NOTE'|t }}</p>
              <p class="booking-calendar-status" data-calendar-status aria-live="polite"></p>
              <button type="button" class="btn btn-secondary booking-calendar-retry" data-calendar-retry hidden>{{ 'PLUGIN_BOOKING.PUBLIC.RETRY'|t }}</button>
              <button type="button" class="btn btn-primary booking-continue" data-make-reservation disabled>
                <span class="booking-continue-label-wide">{{ 'PLUGIN_BOOKING.PUBLIC.CONTINUE_TO_DETAILS'|t }}</span>
                <span class="booking-continue-label-compact">{{ 'PLUGIN_BOOKING.PUBLIC.CONTINUE'|t }}</span>
              </button>
            </aside>
          </div>
        </section>
      </section>

      <section class="booking-step booking-details" data-booking-details hidden>
        <div class="booking-details-heading">
          <div>
            <h2>{{ 'PLUGIN_BOOKING.PUBLIC.BOOKING_DETAILS'|t }}</h2>
            <p class="booking-details-summary" data-booking-summary></p>
          </div>
          <button type="button" class="btn btn-secondary" data-change-dates>
            {{ 'PLUGIN_BOOKING.PUBLIC.CHANGE_DATES'|t }}
          </button>
        </div>

        <div class="booking-form-fields">
          <div class="form-group">
            <label for="customer_name">{{ 'PLUGIN_BOOKING.PUBLIC.YOUR_NAME'|t }} *</label>
            <input type="text" id="customer_name" name="customer_name" required class="form-control"
                   maxlength="255" value="{{ requester.name|default('')|e('html_attr') }}" data-requester-field>
          </div>
          <div class="form-group">
            <label for="customer_email">{{ 'PLUGIN_BOOKING.PUBLIC.YOUR_EMAIL'|t }} *</label>
            <input type="email" id="customer_email" name="customer_email" required class="form-control"
                   maxlength="255" value="{{ requester.email|default('')|e('html_attr') }}" data-requester-field>
          </div>
          <div class="form-group">
            <label for="customer_phone">{{ 'PLUGIN_BOOKING.PUBLIC.YOUR_PHONE'|t }}</label>
            <input type="tel" id="customer_phone" name="customer_phone" class="form-control" maxlength="50" data-requester-field>
          </div>
          <div class="form-group">
            <label for="customer_note">{{ 'PLUGIN_BOOKING.PUBLIC.YOUR_NOTES'|t }}</label>
            <textarea id="customer_note" name="customer_note" class="form-control" rows="4" maxlength="5000" data-requester-field></textarea>
          </div>
        </div>
        <button type="submit" class="btn btn-primary" data-booking-submit>
          {{ 'PLUGIN_BOOKING.PUBLIC.SUBMIT_BOOKING'|t }}
        </button>
      </section>

      <section class="booking-step booking-verification" data-email-verification hidden>
        <h2>{{ 'PLUGIN_BOOKING.PUBLIC.VERIFY_EMAIL_TITLE'|t }}</h2>
        <p data-verification-status>{{ 'PLUGIN_BOOKING.PUBLIC.VERIFY_EMAIL_HINT'|t }}</p>
        <div class="form-group">
          <label for="verification_code">{{ 'PLUGIN_BOOKING.PUBLIC.VERIFICATION_CODE'|t }} *</label>
          <input type="text" id="verification_code" name="verification_code" class="form-control" inputmode="numeric"
                 autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required disabled data-verification-field>
        </div>
        <input type="hidden" name="booking_id" value="" disabled data-verification-booking-id>
        <div class="booking-verification-actions">
          <button type="button" class="btn btn-primary" data-verify-email>{{ 'PLUGIN_BOOKING.PUBLIC.VERIFY_EMAIL'|t }}</button>
          <button type="button" class="btn btn-secondary" data-resend-verification>{{ 'PLUGIN_BOOKING.PUBLIC.RESEND_CODE'|t }}</button>
        </div>
      </section>
      <div class="booking-messages" data-booking-messages aria-live="polite"></div>
    </form>
  {% endif %}
</div>

<style>
.booking-trap { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; }
.booking-public { --booking-green:#218838; --booking-red:#a8323e; --booking-border:rgba(127,127,127,.28); max-width:76rem; margin-inline:auto; }
.booking-public [hidden] { display:none !important; }
.booking-header { margin-block:clamp(2rem,6vw,4rem) 2rem; }
.booking-header h1 { margin:0 0 .75rem; }
.booking-page-content { max-width:58rem; font-size:1.05rem; line-height:1.65; }
.booking-page-content:empty { display:none; }
.booking-page-content > :last-child { margin-bottom:0; }
.booking-progress { margin:1.5rem 0 1rem; }
.booking-progress ol { display:flex; gap:.6rem; list-style:none; margin:0; padding:0; max-width:58rem; }
.booking-progress li { display:flex; flex:1; align-items:center; gap:.6rem; padding:.55rem .75rem; border:1px solid var(--booking-border); border-radius:.55rem; opacity:.68; }
.booking-progress li.is-current { border-color:var(--booking-primary,#6f42c1); background:color-mix(in srgb,var(--booking-primary,#6f42c1) 8%,transparent); opacity:1; font-weight:700; }
.booking-progress li.is-complete { opacity:.85; }
.booking-progress-number { display:grid; width:1.65rem; height:1.65rem; flex:0 0 1.65rem; place-items:center; border:1px solid currentColor; border-radius:50%; font-size:.82rem; }
.booking-step { margin-block:1.5rem; }
.booking-choice-row { display:grid; grid-template-columns:repeat(2,minmax(14rem,1fr)); gap:1rem; max-width:52rem; }
.booking-calendar { margin-top:1.25rem; padding:1.15rem; border:1px solid var(--booking-border); border-radius:.75rem; }
.booking-calendar-heading,.booking-calendar-controls,.booking-details-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
.booking-calendar-heading h2,.booking-details-heading h2 { margin:0 0 .35rem; font-size:1.3rem; }
.booking-muted { opacity:.72; margin:.25rem 0; }
.booking-calendar-legend { display:flex; gap:1rem; flex-wrap:wrap; font-size:.9rem; }
.booking-calendar-legend span { display:inline-flex; align-items:center; gap:.4rem; }
.booking-dot { width:.7rem; height:.7rem; display:inline-block; border-radius:50%; }
.booking-dot-available { background:var(--booking-green); }
.booking-dot-unavailable { background:var(--booking-red); }
.booking-calendar-layout { display:grid; grid-template-columns:minmax(0,1fr) minmax(14rem,17rem); gap:1.25rem; align-items:start; margin-top:.75rem; }
.booking-calendar-main { min-width:0; }
.booking-calendar-controls { justify-content:center; margin:1rem 0; }
.booking-calendar-controls h3 { min-width:12rem; margin:0; text-align:center; }
.booking-month-button { min-width:2.75rem; font-size:1.3rem; line-height:1; }
.booking-calendar-grid { min-width:0; }
.booking-weekdays,.booking-days { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:.35rem; }
.booking-weekdays { margin-bottom:.4rem; }
.booking-weekday { padding:.5rem .25rem; text-align:center; font-size:.82rem; font-weight:600; opacity:.75; }
.booking-day { position:relative; min-height:3.9rem; padding:.45rem; text-align:left; border:1px solid var(--booking-border); border-radius:.45rem; color:inherit; background:transparent; cursor:pointer; }
.booking-day:hover:not(:disabled) { outline:2px solid currentColor; outline-offset:1px; }
.booking-day:focus-visible { outline:3px solid var(--booking-primary,#6f42c1); outline-offset:2px; z-index:1; }
.booking-day:disabled { cursor:not-allowed; opacity:.55; }
.booking-day-available { background:color-mix(in srgb,var(--booking-green) 13%,transparent); border-color:color-mix(in srgb,var(--booking-green) 55%,var(--booking-border)); }
.booking-day-unavailable { background:color-mix(in srgb,var(--booking-red) 12%,transparent); border-color:color-mix(in srgb,var(--booking-red) 55%,var(--booking-border)); }
.booking-day-in-range { background:color-mix(in srgb,var(--booking-primary,#6f42c1) 18%,Canvas); border-color:color-mix(in srgb,var(--booking-primary,#6f42c1) 58%,var(--booking-border)); }
.booking-day-selected { background:var(--booking-primary,#6f42c1); border-color:var(--booking-primary,#6f42c1); color:#fff; box-shadow:inset 0 0 0 2px Canvas; }
.booking-day-selected .booking-day-state { color:#fff; }
.booking-day-other-month:not(.booking-day-selected):not(.booking-day-in-range) { opacity:.55; }
.booking-day-number { display:block; font-weight:700; }
.booking-day-selection-label { display:block; margin-top:.12rem; font-size:.58rem; line-height:1; font-weight:700; }
.booking-day-state { display:block; margin-top:.2rem; font-size:.7rem; }
.booking-selection-panel { position:sticky; top:5.25rem; align-self:start; padding:1rem; border:1px solid var(--booking-border); border-radius:.7rem; background:color-mix(in srgb,Canvas 96%,var(--booking-primary,#6f42c1) 4%); color:CanvasText; }
.booking-selection-panel h3 { margin:0 0 .9rem; font-size:1.1rem; }
.booking-selection-summary { display:grid; gap:.75rem; margin:0 0 .9rem; }
.booking-selection-summary > div { display:flex; flex-direction:column; gap:.12rem; }
.booking-selection-summary dt { font-size:.82rem; opacity:.72; }
.booking-selection-summary dd { margin:0; font-size:1.15rem; font-weight:700; }
.booking-calendar-status { min-height:1.5rem; margin:.75rem 0; }
.booking-checkout-note { font-size:.82rem; line-height:1.4; margin:.5rem 0 1rem; }
.booking-selection-panel .btn { width:100%; }
.booking-calendar-retry { margin-bottom:.5rem; }
.booking-continue { white-space:normal; }
.booking-continue-label-compact { display:none; }
.booking-public.has-floating-selection { padding-bottom:8rem; }
.booking-selection-panel.is-floating { position:fixed; z-index:1000; left:50%; bottom:max(.75rem,env(safe-area-inset-bottom)); width:min(calc(100vw - 1.5rem),40rem); transform:translateX(-50%); display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:.2rem 1rem; padding:.7rem .85rem; background:Canvas; box-shadow:0 -.65rem 2rem rgba(0,0,0,.18); }
.booking-selection-panel.is-floating h3 { grid-column:1; margin:0; font-size:.82rem; }
.booking-selection-panel.is-floating .booking-selection-summary { grid-column:1; grid-row:2; display:flex; flex-wrap:wrap; gap:.15rem .8rem; margin:0; }
.booking-selection-panel.is-floating .booking-selection-summary > div { gap:0; }
.booking-selection-panel.is-floating .booking-selection-summary dt { font-size:.68rem; line-height:1.15; }
.booking-selection-panel.is-floating .booking-selection-summary dd { font-size:.92rem; line-height:1.25; }
.booking-selection-panel.is-floating .booking-calendar-status { grid-column:1; grid-row:3; min-height:0; margin:.2rem 0 0; font-size:.78rem; }
.booking-selection-panel.is-floating .booking-checkout-note { display:none; }
.booking-selection-panel.is-floating .booking-continue { grid-column:2; grid-row:1 / span 2; width:auto; white-space:nowrap; }
.booking-selection-panel.is-floating .booking-continue-label-wide { display:none; }
.booking-selection-panel.is-floating .booking-continue-label-compact { display:inline; }
.booking-selection-panel.is-floating .booking-calendar-retry { grid-column:2; grid-row:3; margin:0; }
.booking-details { scroll-margin-top:5.5rem; padding:1.25rem; border:1px solid var(--booking-border); border-radius:.75rem; }
.booking-details-heading { padding-bottom:1rem; margin-bottom:1rem; border-bottom:1px solid var(--booking-border); }
.booking-details-summary { margin:.35rem 0 0; opacity:.8; }
.booking-form-fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 1rem; }
.booking-verification { max-width:34rem; }
.booking-verification-actions { display:flex; gap:.75rem; flex-wrap:wrap; margin-top:1rem; }
.booking-form-fields .form-group:last-child { grid-column:1/-1; }
.booking-messages:empty { display:none; }
@media(max-width:900px) {
  .booking-calendar-layout { grid-template-columns:1fr; }
  .booking-selection-panel { position:static; }
  .booking-selection-panel.is-floating { position:fixed; }
}
@media(max-width:700px) {
  .booking-choice-row,.booking-form-fields { grid-template-columns:1fr; }
  .booking-form-fields .form-group:last-child { grid-column:auto; }
  .booking-calendar { padding:.8rem; }
  .booking-calendar-heading,.booking-details-heading { align-items:flex-start; flex-direction:column; }
  .booking-calendar-legend { margin-top:.5rem; }
  .booking-calendar-controls h3 { min-width:0; flex:1; font-size:1.05rem; }
  .booking-month-button { min-width:2.25rem; padding-inline:.4rem; }
  .booking-progress ol { gap:.35rem; }
  .booking-progress li { flex-direction:column; align-items:flex-start; gap:.3rem; padding:.5rem; font-size:.78rem; }
  .booking-day { min-height:3.45rem; padding:.35rem .2rem; text-align:center; }
  .booking-day-selection-label { display:none; }
  .booking-day-state { font-size:0; margin-top:.2rem; line-height:1; }
  .booking-day-available .booking-day-state::before { content:'✓'; color:var(--booking-green); font-size:.72rem; font-weight:700; }
  .booking-day-unavailable .booking-day-state::before { content:'×'; color:var(--booking-red); font-size:.78rem; font-weight:700; }
  .booking-day-selected .booking-day-state::before { color:#fff; }
}
@media(max-width:380px) {
  .booking-calendar { padding:.55rem; }
  .booking-weekdays,.booking-days { gap:.18rem; }
  .booking-day { min-height:3.1rem; padding:.25rem .1rem; border-radius:.3rem; }
  .booking-selection-panel.is-floating { width:calc(100vw - 1rem); padding:.6rem .65rem; gap:.2rem .55rem; }
  .booking-selection-panel.is-floating .booking-selection-summary { gap:.1rem .5rem; }
  .booking-selection-panel.is-floating .booking-continue { padding:.55rem .7rem; font-size:.88rem; }
}
</style>

{% if facilities is not empty %}
<script>
(() => {
  const form = document.getElementById('booking-form');
  if (!form || form.dataset.initialized === 'true') return;
  form.dataset.initialized = 'true';

  const facilitySelect = form.querySelector('[data-booking-facility]');
  const resourceSelect = form.querySelector('[data-booking-resource]');
  const periodSelect = form.querySelector('[data-booking-period]');
  const resourceGroup = form.querySelector('[data-resource-group]');
  const periodGroup = form.querySelector('[data-period-group]');
  const selectionStep = form.querySelector('[data-booking-selection]');
  const detailsStep = form.querySelector('[data-booking-details]');
  const verificationStep = form.querySelector('[data-email-verification]');
  const verificationCode = form.querySelector('[data-verification-field]');
  const verificationBookingId = form.querySelector('[data-verification-booking-id]');
  const verificationStatus = form.querySelector('[data-verification-status]');
  const verifyButton = form.querySelector('[data-verify-email]');
  const resendButton = form.querySelector('[data-resend-verification]');
  const requesterFields = [...form.querySelectorAll('[data-requester-field]')];
  const calendarSection = form.querySelector('[data-calendar-section]');
  const weekdaysNode = form.querySelector('[data-calendar-weekdays]');
  const daysNode = form.querySelector('[data-calendar-days]');
  const monthNode = form.querySelector('[data-calendar-month]');
  const calendarStatus = form.querySelector('[data-calendar-status]');
  const calendarRetry = form.querySelector('[data-calendar-retry]');
  const selectionSummary = form.querySelector('[data-selection-summary]');
  const selectedStartNode = form.querySelector('[data-selected-start]');
  const selectedEndNode = form.querySelector('[data-selected-end]');
  const selectedEndWrap = form.querySelector('[data-selected-end-wrap]');
  const checkoutNote = form.querySelector('[data-checkout-note]');
  const makeReservation = form.querySelector('[data-make-reservation]');
  const bookingSummary = form.querySelector('[data-booking-summary]');
  const message = form.querySelector('[data-booking-messages]');
  const submit = form.querySelector('[data-booking-submit]');
  const progressSteps = [...form.querySelectorAll('[data-booking-progress-step]')];
  const selectionPanel = form.querySelector('[data-selection-panel]');
  const publicContainer = form.closest('.booking-public');
  const apiBase = form.dataset.apiBase.replace(/\/$/, '');
  let facilities = JSON.parse(form.dataset.facilities);
  let visibleMonth = null;
  let selectedStart = '';
  let selectedEnd = '';
  let availability = new Map();
  let requestSequence = 0;
  let loading = false;
  let detailsVisible = false;

  const copy = {
    available: '{{ 'PLUGIN_BOOKING.PUBLIC.AVAILABLE'|t|e('js') }}',
    unavailable: '{{ 'PLUGIN_BOOKING.PUBLIC.UNAVAILABLE'|t|e('js') }}',
    selectCheckIn: '{{ 'PLUGIN_BOOKING.PUBLIC.SELECT_CHECK_IN'|t|e('js') }}',
    selectCheckOut: '{{ 'PLUGIN_BOOKING.PUBLIC.SELECT_CHECK_OUT'|t|e('js') }}',
    chooseResource: '{{ 'PLUGIN_BOOKING.PUBLIC.SELECT_RESOURCE'|t|e('js') }}',
    choosePeriod: '{{ 'PLUGIN_BOOKING.PUBLIC.SELECT_PERIOD_PROMPT'|t|e('js') }}',
    loading: '{{ 'PLUGIN_BOOKING.PUBLIC.LOADING_AVAILABILITY'|t|e('js') }}',
    loadFailed: '{{ 'PLUGIN_BOOKING.PUBLIC.AVAILABILITY_LOAD_FAILED'|t|e('js') }}',
    rangeUnavailable: '{{ 'PLUGIN_BOOKING.PUBLIC.RANGE_UNAVAILABLE'|t|e('js') }}',
    checkoutNote: '{{ 'PLUGIN_BOOKING.PUBLIC.CHECK_OUT_BOUNDARY_NOTE'|t|e('js') }}',
    checkoutOption: '{{ 'PLUGIN_BOOKING.PUBLIC.CHECKOUT_OPTION'|t|e('js') }}',
    slotUnavailable: '{{ 'PLUGIN_BOOKING.PUBLIC.SLOT_UNAVAILABLE'|t|e('js') }}',
    timeChange: '{{ 'PLUGIN_BOOKING.PUBLIC.TIME_CHANGE_DATE'|t|e('js') }}',
    submitFailure: '{{ 'PLUGIN_BOOKING.PUBLIC.SUBMIT_FAILURE'|t|e('js') }}',
    bookingSuccess: '{{ 'PLUGIN_BOOKING.PUBLIC.BOOKING_SUCCESS'|t|e('js') }}',
    bookingPending: '{{ 'PLUGIN_BOOKING.PUBLIC.BOOKING_PENDING'|t|e('js') }}',
    bookingConfirmed: '{{ 'PLUGIN_BOOKING.PUBLIC.BOOKING_CONFIRMED'|t|e('js') }}',
    verificationSent: '{{ 'PLUGIN_BOOKING.PUBLIC.VERIFICATION_SENT'|t|e('js') }}',
    verificationEmailFailed: '{{ 'PLUGIN_BOOKING.PUBLIC.VERIFICATION_EMAIL_FAILED'|t|e('js') }}',
    verificationCodeInvalid: '{{ 'PLUGIN_BOOKING.PUBLIC.VERIFICATION_CODE_INVALID'|t|e('js') }}',
    verificationSuccess: '{{ 'PLUGIN_BOOKING.PUBLIC.VERIFICATION_SUCCESS'|t|e('js') }}',
    verificationResent: '{{ 'PLUGIN_BOOKING.PUBLIC.VERIFICATION_RESENT'|t|e('js') }}',
    checkIn: '{{ 'PLUGIN_BOOKING.PUBLIC.CHECK_IN'|t|e('js') }}',
    checkOut: '{{ 'PLUGIN_BOOKING.PUBLIC.CHECK_OUT'|t|e('js') }}',
    period: '{{ 'PLUGIN_BOOKING.PUBLIC.SELECT_PERIOD'|t|e('js') }}',
    selectionReady: '{{ 'PLUGIN_BOOKING.PUBLIC.SELECTION_READY'|t|e('js') }}',
    selected: '{{ 'PLUGIN_BOOKING.PUBLIC.SELECTED'|t|e('js') }}'
  };

  const locale = document.documentElement.lang || 'en';
  const formatDate = (key, options = { dateStyle: 'medium' }) => {
    const [year, month, day] = key.split('-').map(Number);
    return new Intl.DateTimeFormat(locale, { ...options, timeZone: 'UTC' })
      .format(new Date(Date.UTC(year, month - 1, day, 12)));
  };
  const dateKey = (date) => `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, '0')}-${String(date.getUTCDate()).padStart(2, '0')}`;
  const keyDate = (key) => {
    const [year, month, day] = key.split('-').map(Number);
    return new Date(Date.UTC(year, month - 1, day, 12));
  };
  const shiftDate = (key, amount) => {
    const date = keyDate(key);
    date.setUTCDate(date.getUTCDate() + amount);
    return dateKey(date);
  };
  const monthKey = (date) => `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, '0')}`;
  const selectedFacility = () => facilities.find((item) => item.id === facilitySelect.value) || null;
  const selectedResource = () => resourceSelect.value || '';
  const selectedPeriod = () => periodSelect.value || '';
  const isResourceBooking = () => Boolean(selectedResource());
  const needsResource = (facility) => facility?.booking_mode === 'resources';
  const todayInZone = (zone) => {
    const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: zone, year: 'numeric', month: '2-digit', day: '2-digit'
    }).formatToParts(new Date()).reduce((result, part) => {
      if (part.type !== 'literal') result[part.type] = part.value;
      return result;
    }, {});
    return `${parts.year}-${parts.month}-${parts.day}`;
  };
  const showMessage = (text, kind = 'info') => {
    message.replaceChildren();
    if (!text) return;
    const notice = document.createElement('p');
    notice.className = `alert alert-${kind}`;
    notice.setAttribute('role', 'status');
    notice.textContent = text;
    message.appendChild(notice);
  };
  const setProgressStep = (activeStep) => {
    progressSteps.forEach((step) => {
      const number = Number(step.dataset.bookingProgressStep);
      const current = number === activeStep;
      step.classList.toggle('is-current', current);
      step.classList.toggle('is-complete', number < activeStep);
      if (current) step.setAttribute('aria-current', 'step');
      else step.removeAttribute('aria-current');
    });
  };
  const setSelectionPanelFloating = (floating) => {
    const isFloating = Boolean(floating) && window.matchMedia('(max-width: 900px)').matches;
    selectionPanel.classList.toggle('is-floating', isFloating);
    publicContainer.classList.toggle('has-floating-selection', isFloating);
  };
  const setStep = (showDetails) => {
    detailsVisible = showDetails;
    selectionStep.hidden = showDetails;
    detailsStep.hidden = !showDetails;
    verificationStep.hidden = true;
    setProgressStep(showDetails ? 2 : 1);
    setSelectionPanelFloating(!showDetails && Boolean(selectedStart));
    verificationCode.disabled = true;
    verificationBookingId.disabled = true;
    requesterFields.forEach((field) => { field.disabled = !showDetails; });
    if (showDetails) {
      detailsStep.scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'start'
      });
      form.querySelector('#customer_name').focus({ preventScroll: true });
    }
  };
  const showVerification = (bookingId, emailSent) => {
    detailsVisible = false;
    selectionStep.hidden = true;
    detailsStep.hidden = true;
    verificationStep.hidden = false;
    setProgressStep(3);
    setSelectionPanelFloating(false);
    verificationCode.disabled = false;
    verificationBookingId.disabled = false;
    verificationBookingId.value = bookingId;
    verificationStatus.textContent = emailSent ? copy.verificationSent : copy.verificationEmailFailed;
    requesterFields.forEach((field) => { field.disabled = true; });
    verificationCode.focus({ preventScroll: true });
  };
  const resetSelection = () => {
    selectedStart = '';
    selectedEnd = '';
    selectionSummary.hidden = true;
    selectedEndWrap.hidden = true;
    checkoutNote.hidden = true;
    makeReservation.disabled = true;
    setSelectionPanelFloating(false);
  };
  const currentCacheKey = () => [facilitySelect.value, selectedResource(), selectedPeriod()].join('|');
  const resetAvailability = () => {
    availability = new Map();
    requestSequence += 1;
    resetSelection();
    renderCalendar();
  };
  const localInstant = (date, time, zone) => {
    const [year, month, day] = date.split('-').map(Number);
    const [hour, minute] = time.split(':').map(Number);
    const wallTime = Date.UTC(year, month - 1, day, hour, minute);
    let candidate = wallTime;
    const formatter = new Intl.DateTimeFormat('en-CA', {
      timeZone: zone, year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', hourCycle: 'h23'
    });
    const partsAt = (instant) => formatter.formatToParts(new Date(instant)).reduce((parts, part) => {
      if (part.type !== 'literal') parts[part.type] = Number(part.value);
      return parts;
    }, {});
    for (let attempt = 0; attempt < 3; attempt += 1) {
      const parts = partsAt(candidate);
      candidate += wallTime - Date.UTC(parts.year, parts.month - 1, parts.day, parts.hour, parts.minute);
    }
    const parts = partsAt(candidate);
    if (parts.year !== year || parts.month !== month || parts.day !== day || parts.hour !== hour || parts.minute !== minute) {
      throw new Error(copy.timeChange);
    }
    return new Date(candidate).toISOString();
  };
  const setCalendarStatus = (text, kind = '') => {
    calendarStatus.textContent = text;
    calendarStatus.className = `booking-calendar-status${kind ? ` text-${kind}` : ''}`;
  };

  const renderWeekdays = () => {
    weekdaysNode.replaceChildren();
    const monday = new Date(Date.UTC(2024, 0, 1, 12));
    for (let day = 0; day < 7; day += 1) {
      const item = document.createElement('div');
      item.className = 'booking-weekday';
      item.setAttribute('role', 'columnheader');
      item.textContent = new Intl.DateTimeFormat(locale, { weekday: 'short', timeZone: 'UTC' })
        .format(new Date(monday.getTime() + day * 86400000));
      weekdaysNode.appendChild(item);
    }
  };

  const rangeIsAvailable = (start, end) => {
    if (!start || !end || end <= start) return false;
    for (let day = start; day < end; day = shiftDate(day, 1)) {
      if (availability.get(day) !== true) return false;
    }
    return true;
  };

  const updateSelectionDisplay = () => {
    const facility = selectedFacility();
    const resourceBooking = isResourceBooking();
    selectionSummary.hidden = !selectedStart;
    selectedStartNode.textContent = selectedStart ? formatDate(selectedStart) : '';
    selectedEndWrap.hidden = resourceBooking || !selectedEnd;
    selectedEndNode.textContent = selectedEnd ? formatDate(selectedEnd) : '';
    checkoutNote.hidden = resourceBooking || !selectedStart;
    setSelectionPanelFloating(Boolean(selectedStart) && !detailsVisible && verificationStep.hidden);
    if (!selectedStart) {
      setCalendarStatus(loading ? copy.loading : copy.selectCheckIn);
      makeReservation.disabled = true;
      return;
    }
    if (resourceBooking) {
      setCalendarStatus(copy.selectionReady, 'success');
      makeReservation.disabled = loading || availability.get(selectedStart) !== true;
      return;
    }
    if (!selectedEnd) {
      setCalendarStatus(copy.selectCheckOut);
      makeReservation.disabled = true;
      return;
    }
    const valid = rangeIsAvailable(selectedStart, selectedEnd);
    setCalendarStatus(valid ? copy.selectionReady : copy.rangeUnavailable, valid ? 'success' : 'warning');
    makeReservation.disabled = loading || !valid;
    if (!facility) makeReservation.disabled = true;
  };

  const renderCalendar = () => {
    if (!visibleMonth || !selectedFacility()) return;
    const facility = selectedFacility();
    const first = new Date(Date.UTC(visibleMonth.getUTCFullYear(), visibleMonth.getUTCMonth(), 1, 12));
    monthNode.textContent = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(first);
    const today = todayInZone(facility.timezone);
    const firstGridDay = new Date(first);
    firstGridDay.setUTCDate(firstGridDay.getUTCDate() - ((firstGridDay.getUTCDay() + 6) % 7));
    daysNode.replaceChildren();
    for (let offset = 0; offset < 42; offset += 1) {
      const day = new Date(firstGridDay);
      day.setUTCDate(day.getUTCDate() + offset);
      const key = dateKey(day);
      const available = availability.get(key);
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'booking-day';
      button.setAttribute('role', 'gridcell');
      button.dataset.date = key;
      if (day.getUTCMonth() !== first.getUTCMonth()) button.classList.add('booking-day-other-month');
      if (available === true) button.classList.add('booking-day-available');
      if (available === false) button.classList.add('booking-day-unavailable');
      if (key === selectedStart || key === selectedEnd) button.classList.add('booking-day-selected');
      if (selectedStart && selectedEnd && key > selectedStart && key < selectedEnd) button.classList.add('booking-day-in-range');
      const isPast = key < today;
      const startAllowed = available === true && !isPast;
      const canPickCheckout = !isResourceBooking() && selectedStart && key > selectedStart && !isPast;
      button.disabled = isPast || loading || (available === undefined) || (!available && !canPickCheckout);
      const dayNumber = document.createElement('span');
      dayNumber.className = 'booking-day-number';
      dayNumber.textContent = String(day.getUTCDate());
      button.appendChild(dayNumber);
      const selectedLabel = key === selectedStart
        ? (isResourceBooking() ? copy.selected : copy.checkIn)
        : key === selectedEnd ? copy.checkOut : '';
      if (selectedLabel) {
        const selectionLabel = document.createElement('span');
        selectionLabel.className = 'booking-day-selection-label';
        selectionLabel.textContent = selectedLabel;
        button.appendChild(selectionLabel);
      }
      const status = document.createElement('span');
      status.className = 'booking-day-state';
      status.textContent = available === true ? copy.available : available === false ? copy.unavailable : '';
      button.appendChild(status);
      const statusText = available === undefined ? '' : available ? copy.available : copy.unavailable;
      const checkoutOnly = available === false && canPickCheckout ? `, ${copy.checkoutOption}` : '';
      const selectedAnnouncement = key === selectedStart
        ? `, ${isResourceBooking() ? copy.selected : copy.checkIn}`
        : key === selectedEnd ? `, ${copy.checkOut}` : '';
      button.setAttribute('aria-label', `${formatDate(key, { dateStyle: 'full' })}${statusText ? `, ${statusText}` : ''}${selectedAnnouncement}${checkoutOnly}`);
      button.setAttribute('aria-selected', String(key === selectedStart || key === selectedEnd));
      button.addEventListener('click', () => chooseDate(key, startAllowed, canPickCheckout));
      daysNode.appendChild(button);
    }
    updateSelectionDisplay();
    const minimumMonth = monthKey(keyDate(today));
    form.querySelector('[data-calendar-previous]').disabled = monthKey(first) <= minimumMonth;
  };

  const fetchCalendar = async (force = false) => {
    const facility = selectedFacility();
    if (!facility) return;
    const sequence = ++requestSequence;
    if (isResourceBooking() && !selectedPeriod()) {
      calendarSection.hidden = true;
      setCalendarStatus(copy.choosePeriod);
      return;
    }
    const cacheKey = currentCacheKey();
    const first = new Date(Date.UTC(visibleMonth.getUTCFullYear(), visibleMonth.getUTCMonth(), 1, 12));
    const firstGridDay = new Date(first);
    firstGridDay.setUTCDate(firstGridDay.getUTCDate() - ((firstGridDay.getUTCDay() + 6) % 7));
    const from = dateKey(firstGridDay);
    const to = shiftDate(from, 42);
    const cached = availabilityCache.get(cacheKey) || new Map();
    const missing = [];
    for (let offset = 0; offset < 42; offset += 1) {
      const day = shiftDate(from, offset);
      if (force || !cached.has(day)) missing.push(day);
    }
    availability = cached;
    calendarRetry.hidden = true;
    calendarSection.hidden = false;
    if (missing.length === 0) {
      loading = false;
      renderCalendar();
      return;
    }
    loading = true;
    renderCalendar();
    setCalendarStatus(copy.loading);
    const query = new URLSearchParams({ facility_id: facility.id, from, to });
    if (selectedResource()) query.set('resource_id', selectedResource());
    if (selectedPeriod()) query.set('period_id', selectedPeriod());
    try {
      const response = await fetch(`${apiBase}/availability?${query}`, { credentials: 'same-origin', cache: 'no-store' });
      const result = await response.json();
      const data = result.data || result;
      if (!response.ok) {
        console.error(`Booking calendar API returned HTTP ${response.status}.`, result);
        throw new Error(copy.loadFailed);
      }
      if (sequence !== requestSequence) return;
      if (!Array.isArray(data.availability)) throw new Error(copy.loadFailed);
      data.availability.forEach((item) => cached.set(item.date, Boolean(item.available)));
      availabilityCache.set(cacheKey, cached);
      availability = cached;
      loading = false;
      renderCalendar();
      if (data.partial_failure) {
        setCalendarStatus(copy.loadFailed, 'warning');
        calendarRetry.hidden = false;
      }
    } catch (error) {
      if (sequence !== requestSequence) return;
      console.error('Booking calendar availability request failed.', error);
      loading = false;
      renderCalendar();
      setCalendarStatus(copy.loadFailed, 'warning');
      calendarRetry.hidden = false;
    }
  };

  const availabilityCache = new Map();

  const chooseDate = (key, startAllowed, canPickCheckout) => {
    showMessage('');
    if (key === selectedStart) {
      // Let visitors undo check-in selection so they can choose a later start
      // date without changing the facility or reloading the calendar.
      selectedStart = '';
      selectedEnd = '';
    } else if (!isResourceBooking() && key === selectedEnd) {
      selectedEnd = '';
    } else if (isResourceBooking()) {
      if (!startAllowed) return;
      selectedStart = key;
      selectedEnd = '';
    } else if (!selectedStart || key <= selectedStart) {
      if (!startAllowed) return;
      selectedStart = key;
      selectedEnd = '';
    } else if (canPickCheckout) {
      selectedEnd = key;
      if (!rangeIsAvailable(selectedStart, key)) {
        setCalendarStatus(copy.rangeUnavailable, 'warning');
      }
    }
    renderCalendar();
  };

  const populateChoices = () => {
    const facility = selectedFacility();
    resourceSelect.replaceChildren(new Option('{{ 'PLUGIN_BOOKING.PUBLIC.SELECT_RESOURCE'|t|e('js') }}...', ''));
    periodSelect.replaceChildren(new Option(copy.choosePeriod + '...', ''));
    (facility?.resources || []).forEach((item) => resourceSelect.add(new Option(item.name, item.id)));
    const showResource = Boolean(facility && facility.resources?.length && facility.booking_mode !== 'facility');
    resourceGroup.hidden = !showResource;
    resourceSelect.required = Boolean(showResource && needsResource(facility));
    resourceSelect.disabled = !showResource;
    periodGroup.hidden = true;
    periodSelect.required = false;
    periodSelect.disabled = true;
    resetSelection();
    availability = new Map();
    if (!facility) {
      calendarSection.hidden = true;
      visibleMonth = null;
      renderCalendar();
      return;
    }
    visibleMonth = keyDate(todayInZone(facility.timezone).slice(0, 7) + '-01');
    if (facility.booking_mode === 'resources') {
      resourceGroup.hidden = false;
    }
    syncCalendarContext();
  };

  const syncCalendarContext = () => {
    const facility = selectedFacility();
    if (!facility) return;
    if (needsResource(facility) && !selectedResource()) {
      calendarSection.hidden = true;
      resetAvailability();
      setCalendarStatus(copy.chooseResource);
      return;
    }
    if (selectedResource()) {
      periodGroup.hidden = false;
      periodSelect.disabled = false;
      periodSelect.required = true;
    }
    const needsPeriod = Boolean(selectedResource());
    calendarSection.hidden = needsPeriod && !selectedPeriod();
    resetAvailability();
    if (!needsPeriod || selectedPeriod()) fetchCalendar();
    else setCalendarStatus(copy.choosePeriod);
  };

  const buildRange = () => {
    const facility = selectedFacility();
    if (!facility || !selectedStart) throw new Error(copy.selectCheckIn);
    const resourceBooking = isResourceBooking();
    const options = facility.booking_options || {};
    let startTime;
    let endTime;
    let endDate;
    if (resourceBooking) {
      const slot = (options.resource_slots || []).find((item) => item.id === selectedPeriod());
      if (!slot) throw new Error(copy.choosePeriod);
      startTime = slot.start_time;
      endTime = slot.end_time;
      endDate = selectedStart;
    } else {
      if (!selectedEnd || !rangeIsAvailable(selectedStart, selectedEnd)) throw new Error(copy.rangeUnavailable);
      startTime = options.whole_day_start_time || '12:00';
      endTime = options.whole_day_end_time || '12:00';
      endDate = selectedEnd;
    }
    const start = localInstant(selectedStart, startTime, facility.timezone);
    const end = localInstant(endDate, endTime, facility.timezone);
    if (new Date(end) <= new Date(start)) throw new Error(copy.rangeUnavailable);
    return { start, end, facility, endDate, startTime, endTime, resourceBooking };
  };

  const makeDetailsSummary = (range) => {
    const resource = (range.facility.resources || []).find((item) => item.id === selectedResource());
    const slot = (range.facility.booking_options?.resource_slots || []).find((item) => item.id === selectedPeriod());
    const pieces = [range.facility.name];
    if (resource) pieces.push(resource.name);
    pieces.push(`${copy.checkIn}: ${formatDate(selectedStart)} ${range.startTime}`);
    if (!range.resourceBooking) pieces.push(`${copy.checkOut}: ${formatDate(range.endDate)} ${range.endTime}`);
    if (slot) pieces.push(`${copy.period}: ${slot.label}`);
    pieces.push(range.facility.timezone);
    return pieces.join(' · ');
  };

  form.querySelector('[data-calendar-previous]').addEventListener('click', () => {
    visibleMonth.setUTCMonth(visibleMonth.getUTCMonth() - 1);
    renderCalendar();
    fetchCalendar();
  });
  form.querySelector('[data-calendar-next]').addEventListener('click', () => {
    visibleMonth.setUTCMonth(visibleMonth.getUTCMonth() + 1);
    renderCalendar();
    fetchCalendar();
  });
  calendarRetry.addEventListener('click', () => fetchCalendar(true));
  makeReservation.addEventListener('click', () => {
    try {
      const range = buildRange();
      bookingSummary.textContent = makeDetailsSummary(range);
      showMessage('');
      setStep(true);
    } catch (error) {
      showMessage(error.message || copy.rangeUnavailable, 'warning');
    }
  });
  form.querySelector('[data-change-dates]').addEventListener('click', () => setStep(false));

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!detailsVisible) {
      if (!verificationStep.hidden) verifyButton.click();
      return;
    }
    if (!form.reportValidity()) return;
    submit.disabled = true;
    try {
      const range = buildRange();
      const payload = new FormData(form);
      payload.set('start', range.start);
      payload.set('end', range.end);
      payload.delete('date');
      payload.delete('end_date');
      payload.delete('period_id');
      const response = await fetch(`${apiBase}/reservations`, {
        method: 'POST', credentials: 'same-origin', body: payload
      });
      const result = await response.json();
      const data = result.data || result;
      if (response.status === 409) {
        setStep(false);
        showMessage(copy.slotUnavailable, 'warning');
        await fetchCalendar(true);
        return;
      }
      if (!response.ok) throw new Error(copy.submitFailure);
      if (data.verification_required) {
        showMessage('');
        showVerification(data.booking.id, Boolean(data.verification_email_sent));
      } else {
        const success = data.booking?.status === 'confirmed' ? copy.bookingConfirmed : copy.bookingPending || copy.bookingSuccess;
        showMessage(success, 'success');
        form.reset();
        setStep(false);
        populateChoices();
      }
    } catch (error) {
      showMessage(error.message || copy.submitFailure, 'danger');
    } finally {
      submit.disabled = false;
    }
  });

  verifyButton.addEventListener('click', async () => {
    if (!verificationCode.reportValidity()) return;
    verifyButton.disabled = true;
    try {
      const payload = new FormData(form);
      payload.set('booking_id', verificationBookingId.value);
      const response = await fetch(`${apiBase}/reservations/verify`, {
        method: 'POST', credentials: 'same-origin', body: payload
      });
      const result = await response.json();
      const data = result.data || result;
      if (!response.ok) {
        const expiredConflict = String(data.message || '').toLowerCase().includes('no longer available');
        throw new Error(expiredConflict ? copy.slotUnavailable : copy.verificationCodeInvalid);
      }
      verificationStep.hidden = true;
      showMessage(data.booking?.status === 'confirmed' ? copy.bookingConfirmed : copy.bookingPending || copy.verificationSuccess, 'success');
      form.reset();
      setStep(false);
      populateChoices();
    } catch (error) {
      showMessage(error.message || copy.verificationCodeInvalid, 'danger');
    } finally {
      verifyButton.disabled = false;
    }
  });

  resendButton.addEventListener('click', async () => {
    resendButton.disabled = true;
    try {
      const payload = new FormData(form);
      payload.set('booking_id', verificationBookingId.value);
      const response = await fetch(`${apiBase}/reservations/resend-verification`, {
        method: 'POST', credentials: 'same-origin', body: payload
      });
      const result = await response.json();
      const data = result.data || result;
      if (!response.ok) throw new Error(data.message || copy.verificationEmailFailed);
      verificationCode.value = '';
      verificationStatus.textContent = copy.verificationResent;
    } catch (error) {
      verificationStatus.textContent = error.message || copy.verificationEmailFailed;
    } finally {
      resendButton.disabled = false;
    }
  });

  renderWeekdays();
  setStep(false);
  facilitySelect.addEventListener('change', () => {
    showMessage('');
    populateChoices();
  });
  resourceSelect.addEventListener('change', () => {
    showMessage('');
    const facility = selectedFacility();
    periodSelect.replaceChildren(new Option(copy.choosePeriod + '...', ''));
    if (selectedResource()) {
      periodGroup.hidden = false;
      periodSelect.disabled = false;
      periodSelect.required = true;
      (facility?.booking_options?.resource_slots || []).forEach((slot) => periodSelect.add(new Option(slot.label, slot.id)));
    } else {
      periodGroup.hidden = true;
      periodSelect.disabled = true;
      periodSelect.required = false;
    }
    resetSelection();
    syncCalendarContext();
  });
  periodSelect.addEventListener('change', () => {
    showMessage('');
    syncCalendarContext();
  });
  facilitySelect.dispatchEvent(new Event('change'));
  window.addEventListener('resize', () => {
    setSelectionPanelFloating(Boolean(selectedStart) && !detailsVisible && verificationStep.hidden);
  });
})();
</script>
{% endif %}
{% endblock %}
